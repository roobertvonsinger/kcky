# ==============================================================================
# ONBOARDED — Git Ignore Rules
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Logs & temporales
*.log
*.tmp
*.y4m

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Directorios de datos efímeros y persistentes
data/uploads/*
data/buffers/*
data/sessions/*
data/identities/*
!data/uploads/.gitkeep
!data/buffers/.gitkeep
!data/sessions/.gitkeep
!data/identities/.gitkeep
*.db
*.db-wal
*.db-shm

# Preservar presets de video base
!data/presets/
!data/presets/*.mp4
data/presets/audit/

# Modelos pesados ONNX (si se descargan localmente)
models/*.onnx
*.onnx

# IDE, OS & Testing
.vscode/
.idea/
.DS_Store
Thumbs.db
.pytest_cache/
.coverage
htmlcov/
